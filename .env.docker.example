# Copy to .env.docker, then replace the example host and credentials with Neon values.
APP_PORT=8080
DB_URL=jdbc:postgresql://ep-example-123456.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace_with_neon_password
JWT_SECRET=ChangeThis_To_A_Random_Secret_At_Least_32_Bytes
JWT_EXPIRATION_MS=86400000
JPA_SHOW_SQL=false

# Optional: leave empty if you do not need OTP email delivery.
MAIL_USERNAME=
MAIL_PASSWORD=
