# Copy to .env.docker, then fill in your own credentials. Never put real secrets here.
APP_PORT=8080
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
DB_USERNAME=YOUR_NEON_USERNAME
DB_PASSWORD=YOUR_NEON_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000
JPA_SHOW_SQL=false

# Optional integrations. Leave blank if not used; upload/payment actions will be unavailable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay-return
GOOGLE_MAPS_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
